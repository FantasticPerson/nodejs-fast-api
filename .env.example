# Management server
HOST=127.0.0.1
PORT=3000

# Keep empty for local-only access. Set a long random value before exposing the server.
ADMIN_TOKEN=

# Optional token required by generated APIs. Leave empty to keep them public.
OPENAPI_TOKEN=

# Oracle Database 11g requires node-oracledb Thick mode and Oracle Client libraries.
ORACLE_THICK_MODE=false
# Optional Oracle Client library directory, for example /opt/oracle/instantclient_19_XX.
# Setting this directory also enables Thick mode. On Linux, the directory must
# also be available via ldconfig or LD_LIBRARY_PATH before Node.js starts.
ORACLE_CLIENT_LIB_DIR=

# Generated API base path
OPENAPI_PATH=/openapi

# Maximum time for one generated API query, in milliseconds. Set 0 to disable.
# An endpoint-specific timeoutMs overrides this value; 0 there inherits it.
QUERY_TIMEOUT_MS=30000

# Maximum execution time for JavaScript business-script endpoints.
SCRIPT_TIMEOUT_MS=30000
# Comma separated hosts allowed for script http.fetch(), for example:
# api.example.com,*.internal.example.com. Leave empty to deny all external HTTP.
SCRIPT_HTTP_ALLOWLIST=
# Maximum external HTTP response body accepted by script endpoints.
SCRIPT_HTTP_MAX_RESPONSE_BYTES=1048576
# Worker memory limit for one script invocation.
SCRIPT_WORKER_MEMORY_MB=128
# Trusted server-side plugin directory. Files ending in .js or .mjs are loaded.
PLUGINS_DIR=plugins

# Comma separated allow-list, or * for all origins. Runtime APIs only.
CORS_ORIGIN=*

# Optional path overrides. STATE_FILE is the legacy JSON source and is imported
# once when the SQLite database has not been initialized.
# STATE_DB=data/state.sqlite
# STATE_FILE=data/state.json
# SECRET_FILE=data/.secret
