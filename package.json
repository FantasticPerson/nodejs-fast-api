{
  "name": "node-magic-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Magic API inspired SQL-to-REST studio for MySQL and Oracle",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check:oracle": "node scripts/check-oracle-connection.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/index.js && node --check public/js/main.js"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.6",
    "oracledb": "^6.10.0"
  },
  "dependencies": {
    "pm2": "^7.1.2"
  }
}
